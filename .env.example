# === Supabase (legacy, being phased out during DO migration) ===
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# === New Postgres on DO droplet ===
# Local dev: run scripts/db-tunnel.sh first to open a tunnel on port 5433.
# In production (inside Docker compose), point at the postgres container:
#   DATABASE_URL=postgresql://adminpapsjanet:PASSWORD@postgres:5432/adminpapsjanet
DATABASE_URL=postgresql://adminpapsjanet:PASSWORD@localhost:5433/adminpapsjanet

# === Session (iron-session) ===
# Any 32+ char random string. Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-32-chars-or-more
